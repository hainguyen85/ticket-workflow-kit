{
  "schemaVersion": 3,
  "git": {
    "remote": "origin",
    "baseBranch": "main",
    "protectedBranches": [
      "main"
    ]
  },
  "docs": {
    "ticketsPath": "docs/tickets"
  },
  "checks": {
    "timeoutSeconds": 600
  },
  "tickets": {
    "types": {
      "req": "REQ",
      "cr": "CR",
      "bug": "BUG"
    },
    "defaultType": "req",
    "changeRequestType": "cr"
  }
}
